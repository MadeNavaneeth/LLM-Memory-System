# --- LLM Memory System Environment Configuration ---

# 🤖 LLM Provider Keys
# Gemini: Get your key at https://aistudio.google.com/app/apikey (Recommended)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI: Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter: Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 🗄️ Database Configuration
# MongoDB Connection URI (Local default: mongodb://localhost:27017/)
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=llm_memory

# SQLite Configuration (Path within project)
SQLITE_DB_PATH=data/memory.db

# ⚙️ System Settings
# Default model to use if none is selected
DEFAULT_MODEL=gemini-1.5-flash
# Enable/Disable NoSQL metadata storage (true/false)
USE_NOSQL=true
